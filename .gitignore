# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed; this repo is public.
.env*
# ...except the template, which carries names and comments but no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local session state — but skills are shared project config,
# not state, and everyone working here should get the same ones.
# Note the /* — git cannot re-include anything under a directory that is
# itself excluded, so the contents are ignored and skills negated back in.
.claude/*
!.claude/skills/

# cloudflare / opennext
.open-next/
.wrangler/
cloudflare-env.d.ts

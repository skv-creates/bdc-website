{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The entry wraps OpenNext's worker to edge-cache /_next/image responses
	// (see worker-entry.js) — the generated handler transforms on every request.
	"main": "worker-entry.js",
	// The top-level config IS staging, deliberately: the existing `bdc-website`
	// Worker already owns the staging custom domain, so keeping it as the default
	// means this split costs staging no downtime. Production is a separate Worker
	// below — two custom domains on ONE Worker would make staging an alias for
	// production rather than a gate in front of it.
	"name": "bdc-website",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [{ "pattern": "staging.bulgariandesigncouncil.org", "custom_domain": true }],
	// The canonical origin, read by lib/site.ts for canonicals, hreflang, the
	// sitemap and robots.
	//
	// The deploy scripts also set this at BUILD time so the prerendered page
	// cache contains the correct canonicals. Keep it here at RUNTIME as well for
	// request-time endpoints and as a safe fallback if a cache entry is ever
	// absent. @opennextjs/cloudflare copies every var here into process.env on
	// each Worker request (populateProcessEnv in its init template).
	//
	// vars are NOT inherited into a named environment, so production repeats it
	// below. Leave it out there and production silently becomes staging again.
	//
	// NOTION_EVENTS_DATA_SOURCE_ID is the same value the events sync workflow
	// holds as a GitHub *variable*, and for the same reason: it identifies a
	// data source, it is not a credential. The Shift+E editor needs it to find
	// the row for a slug. The token that goes with it is a secret and is set
	// with `wrangler secret put`, never here — see AGENTS.md.
	"vars": {
		"SITE_ORIGIN": "https://staging.bulgariandesigncouncil.org",
		"NOTION_EVENTS_DATA_SOURCE_ID": "b51c7693-aa03-8324-9099-87dd784391f9"
	},
	// Copy edited on staging with Shift+E, held until the next Notion sync
	// regenerates lib/events.generated.json. See lib/drafts.ts, which treats a
	// missing binding as "no drafts" rather than an error.
	//
	// HERE AND DELIBERATELY NOT UNDER env.production. Bindings are not inherited
	// into a named environment, so its absence down there is not an oversight to
	// be tidied up later — it is the structural guarantee that the apex cannot
	// serve a draft even if the code is wrong. The IS_PRODUCTION_SITE checks are
	// the second lock, not the only one.
	//
	// The id is not a credential; it names a namespace, and reaching it still
	// requires the account. The secrets that go with this feature —
	// EDIT_PASSPHRASE and NOTION_WRITE_TOKEN — are set with `wrangler secret
	// put --env=""` and appear nowhere in this repository.
	"kv_namespaces": [{ "binding": "DRAFTS", "id": "a6137050fdb64efd96fbac4bc9e6f812" }],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Backs next/image optimization.
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		// Production. Shipped only by the manual "Deploy to production" workflow,
		// never by a push. Every key is repeated rather than inherited: bindings
		// are non-inheritable in Wrangler, and being explicit means a future edit
		// up top cannot silently half-apply down here.
		"production": {
			"name": "bdc-website-production",
			// Apex only. www is a 301 redirect rule in the Cloudflare dashboard, so
			// there is one canonical hostname. Mail stays at SuperHosting: a custom
			// domain rewrites the apex address record only, leaving MX and mail.*
			// alone.
			"routes": [{ "pattern": "bulgariandesigncouncil.org", "custom_domain": true }],
			// See the note on the staging vars above. This one being wrong or
			// absent is what makes the public site noindex itself.
			"vars": { "SITE_ORIGIN": "https://bulgariandesigncouncil.org" },
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}

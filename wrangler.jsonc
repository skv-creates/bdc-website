{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "bdc-website",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Apex + www still serve SuperHosting's parking page; staging is the review
	// surface until we cut them over.
	"routes": [{ "pattern": "staging.bulgariandesigncouncil.org", "custom_domain": true }],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Backs next/image optimization.
	"images": {
		"binding": "IMAGES"
	}
}

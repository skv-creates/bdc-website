{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// The top-level config IS staging, deliberately: the existing `bdc-website`
	// Worker already owns the staging custom domain, so keeping it as the default
	// means this split costs staging no downtime. Production is a separate Worker
	// below — two custom domains on ONE Worker would make staging an alias for
	// production rather than a gate in front of it.
	"name": "bdc-website",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [{ "pattern": "staging.bulgariandesigncouncil.org", "custom_domain": true }],
	// The canonical origin, read by lib/site.ts for canonicals, hreflang, the
	// sitemap and robots.
	//
	// It has to be here, at RUNTIME, not only on the build command. These pages
	// are rendered on demand inside the Worker — there is not a single .html in
	// .open-next — so a value that exists only during `next build` is gone by
	// the time a canonical tag is written, and lib/site.ts falls back to its
	// default. That is how production briefly shipped noindex with staging
	// canonicals. @opennextjs/cloudflare copies every var here into process.env
	// on each request (populateProcessEnv in its init template).
	//
	// vars are NOT inherited into a named environment, so production repeats it
	// below. Leave it out there and production silently becomes staging again.
	"vars": { "SITE_ORIGIN": "https://staging.bulgariandesigncouncil.org" },
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Backs next/image optimization.
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		// Production. Shipped only by the manual "Deploy to production" workflow,
		// never by a push. Every key is repeated rather than inherited: bindings
		// are non-inheritable in Wrangler, and being explicit means a future edit
		// up top cannot silently half-apply down here.
		"production": {
			"name": "bdc-website-production",
			// Apex only. www is a 301 redirect rule in the Cloudflare dashboard, so
			// there is one canonical hostname. Mail stays at SuperHosting: a custom
			// domain rewrites the apex address record only, leaving MX and mail.*
			// alone.
			"routes": [{ "pattern": "bulgariandesigncouncil.org", "custom_domain": true }],
			// See the note on the staging vars above. This one being wrong or
			// absent is what makes the public site noindex itself.
			"vars": { "SITE_ORIGIN": "https://bulgariandesigncouncil.org" },
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}

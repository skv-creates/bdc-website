{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "bdc-website",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The apex is the canonical hostname; www is a redirect rule in the Cloudflare
	// dashboard, not a route here. Staging stays as the review surface.
	// Mail lives at SuperHosting — a custom domain rewrites only the apex address
	// record, so MX and mail.* must stay untouched and grey-clouded.
	"routes": [
		{ "pattern": "staging.bulgariandesigncouncil.org", "custom_domain": true },
		{ "pattern": "bulgariandesigncouncil.org", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Backs next/image optimization.
	"images": {
		"binding": "IMAGES"
	}
}

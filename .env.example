# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values, and never send a token over chat or email.
#
# Used ONLY by `npm run sync:bios`, which runs on an editor's machine, not in
# CI. The deploy workflow builds from the committed
# lib/team-bios.generated.json and has no Notion token. Keeping the credential
# off GitHub entirely is deliberate — this repo is public.

# Your OWN Notion internal integration secret (starts "ntn_").
#
# Each person who syncs creates their own integration rather than sharing one:
# nobody has to hand a secret to anybody, a leak is rotated by one person
# without breaking the other, and Notion attributes access per integration.
#
# Create at notion.so/profile/integrations, then:
#   1. Capabilities — grant "Read content" ONLY. The sync never writes, so an
#      exposed token cannot damage the CMS.
#   2. Connect it to the database: open "Website CMS: Съдържание" →
#      ⋯ → Connections → your integration. Without this, the API returns 404
#      rather than a permissions error.
NOTION_TOKEN=

# The "Екип" tab of the "Website CMS: Съдържание" database. Shared by everyone —
# this is an identifier, not a secret.
#
# This is a DATA SOURCE id, not the database id — that database has six data
# sources, and current Notion API versions can't query those by database id.
NOTION_TEAM_DATA_SOURCE_ID=7fcc7693-aa03-82d8-977a-0794e4752dff

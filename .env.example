# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Used ONLY by `npm run sync:bios`, which runs on an editor's machine, not in CI.
# The deploy workflow does not need these: it builds from the committed
# lib/team-bios.generated.json. Keeping the token off GitHub entirely is
# deliberate — this repo is public.

# Internal integration secret from notion.so/profile/integrations (starts "ntn_").
# The integration must also be connected to the Website CMS database:
# open the database → ⋯ → Connections → your integration.
NOTION_TOKEN=

# The "Екип" tab of the "Website CMS: Съдържание" database.
# This is a DATA SOURCE id, not the database id — that database has six data
# sources, and current Notion API versions can't query those by database id.
NOTION_TEAM_DATA_SOURCE_ID=7fcc7693-aa03-82d8-977a-0794e4752dff

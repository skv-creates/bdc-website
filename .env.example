# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values, and never send a token over chat or email.
#
# Used by the hand-run bios, FAQ and events syncs on an editor's machine. The
# deploy workflows build from committed generated JSON and do not need a Notion
# token. Keeping the credential off GitHub entirely is deliberate — this repo
# is public. The manual sync-events workflow is dormant unless a separate,
# read-only repository secret is deliberately configured for it.

# Your OWN Notion internal integration secret (starts "ntn_").
#
# Each person who syncs creates their own integration rather than sharing one:
# nobody has to hand a secret to anybody, a leak is rotated by one person
# without breaking the other, and Notion attributes access per integration.
#
# Create at notion.so/profile/integrations, then:
#   1. Capabilities — grant "Read content" ONLY. The sync never writes, so an
#      exposed token cannot damage the CMS.
#   2. Connect it to the database: open "Website CMS: Съдържание" →
#      ⋯ → Connections → your integration. Without this, the API returns 404
#      rather than a permissions error.
NOTION_TOKEN=

# The "Екип" tab of the "Website CMS: Съдържание" database. Shared by everyone —
# this is an identifier, not a secret.
#
# This is a DATA SOURCE id, not the database id — that database has six data
# sources, and current Notion API versions can't query those by database id.
NOTION_TEAM_DATA_SOURCE_ID=7fcc7693-aa03-82d8-977a-0794e4752dff

# The "Въпроси (FAQ)" tab of the same database — used by `npm run sync:faq`.
NOTION_FAQ_DATA_SOURCE_ID=369c7693-aa03-8293-9916-07ce004383fb

# The "Събития" tab — used by `npm run sync:events`. The GitHub workflow is
# manual-only; there is no schedule and no shared token in this public repo.
NOTION_EVENTS_DATA_SOURCE_ID=b51c7693-aa03-8324-9099-87dd784391f9

# Which Notion "Статус" counts as publishable for events. Optional — defaults to
# "Готово за публикуване". Set it to move the site to another column without
# editing the sync.
# NOTION_EVENTS_STATUS=Готово за публикуване

# Only needed to test the /partner form's email locally (`npm run dev`). On
# the deployed site it is a Worker secret (`wrangler secret put RESEND_API_KEY`
# per environment), never a variable here or in CI. Without it, submitting the
# form locally lands back on /partner?error=1 — the pages themselves need no key.
# RESEND_API_KEY=
